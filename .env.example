# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Clerk (auth: Google sign-in + incremental Gmail consent) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# --- Database (PlanetScale MySQL) ---
DATABASE_HOST=aws.connect.psdb.cloud
DATABASE_USERNAME=xxx
DATABASE_PASSWORD=pscale_pw_xxx
DATABASE_NAME=subzero

# --- Google OAuth (gmail.readonly ONLY — never write/send scopes) ---
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx

# --- Token encryption at rest (32 bytes, base64) ---
# Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- Claude API (Stage 2 extraction only) ---
ANTHROPIC_API_KEY=sk-ant-xxx

# --- Stripe (Pro billing) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRO_PRICE_ID=price_xxx

# --- Cron auth (Vercel cron sends this as a bearer token) ---
CRON_SECRET=
