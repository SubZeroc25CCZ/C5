# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Clerk (auth: Google sign-in + incremental Gmail consent) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# --- Database (Cloudflare D1, free tier — no card) ---
# Account ID: dash.cloudflare.com → right sidebar. Token: My Profile →
# API Tokens → Create Token → custom, permission "Account / D1 / Edit".
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=e60de52b-b59c-4c7d-b69d-6e691c4648fb
CLOUDFLARE_API_TOKEN=

# --- Google OAuth (gmail.readonly ONLY — never write/send scopes) ---
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx

# --- Token encryption at rest (32 bytes, base64) ---
# Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- Claude API (Stage 2 extraction only) ---
ANTHROPIC_API_KEY=sk-ant-xxx

# --- Stripe (Pro billing) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRO_PRICE_ID=price_xxx

# --- Cron auth (Vercel cron sends this as a bearer token) ---
CRON_SECRET=
